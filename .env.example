# Core engine
WORK_ROOT=/tmp/kids-content-engine
ARTIFACT_ROOT=/tmp/kids-artifacts
RENDER_ENABLED=0
BLENDER_BIN=blender
BLENDER_TIMEOUT_SEC=3600

# AI content generation (optional; fallback generator works without it)
OPENAI_API_KEY=
CONTENT_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
CONTENT_LLM_MODEL=gpt-4o-mini

# Publishing gates
PUBLISH_ENABLED=0
YOUTUBE_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Production TTS can be wired behind the audio provider interface.
TTS_PROVIDER=local
TTS_API_KEY=
TTS_ENDPOINT=
