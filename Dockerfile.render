FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends blender ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
ENV RENDER_ENABLED=1
CMD ["python","-m","pipeline.worker"]
